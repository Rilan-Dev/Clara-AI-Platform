# Clara AI Platform — Environment Variables
# ── IMPORTANT ─────────────────────────────────────────────────────────────────
# 1. Set OPENAI_API_KEY to your real OpenAI key
# 2. Set AUTH_SECRET to a long random string:  openssl rand -base64 64
# 3. Set NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_CLARA_API_URL to your real domains
# 4. Optionally set STRIPE keys (leave blank to disable billing)
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Used by local dev tools connecting to the host-mapped port (5433).
# Inside Docker the apps connect via clara-net using "postgres:5432" directly.
DATABASE_URL=postgresql://clara:clarapassword@localhost:5433/clara_platform?sslmode=disable

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=clara
POSTGRES_PASSWORD=clarapassword
POSTGRES_DB=clara_platform
# Host port remapped to 5433 — avoids conflict with existing postgres-db on 5432
POSTGRES_PORT=5433

# ── Vector Database ───────────────────────────────────────────────────────────
# Qdrant is internal-only (no host port binding). Apps reach it via clara-net.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                          # leave blank for local Qdrant (no auth)

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 64
AUTH_SECRET=change-me-with-a-long-random-string

# ── Public URL (used in emails, embeds, CORS) ─────────────────────────────────
# Set to your real domain after configuring nginx-proxy-manager proxy hosts.
# Example: https://clara.yourdomain.com
NEXT_PUBLIC_APP_URL=https://clara-rag.amazetechclans.com

# ── Stripe (optional — leave blank to disable billing) ───────────────────────
STRIPE_SECRET_KEY=sk_test_51NexCxSH7giJdRbDPdq8CPv7syZVf5Js4VjVGiAnKzLlPFurGtk9qwnncXpCH10RONBtDk0DNxRelkqPcNWtYF4V000rFgoDZQ
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Tenant app org IDs (from seed script) ────────────────────────────────────
OMEN_ORG_ID=10000000-0000-0000-0000-000000000001
TECHVISION_ORG_ID=10000000-0000-0000-0000-000000000002

# ── Tenant apps ───────────────────────────────────────────────────────────────
# Used by clara-omen and clara-techvision to reach the backend.
# Inside Docker this is container-to-container via clara-net. Externally
# set to your real domain for browser-side API calls.
CLARA_BACKEND_URL=http://clara-backend:3000
NEXT_PUBLIC_CLARA_API_URL=https://clara-rag.amazetechclans.com

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── Project Specific ──────────────────────────────────────────────────────────
AUTO_SEED_DEMO=true
LOCAL_INIT_SECRET=clara-local-init
