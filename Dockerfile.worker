# Clara Background Worker — BullMQ crawl job processor
# Build context: repository root (`.`)
# Run: docker compose up clara-worker
#
# This service processes Clara's BullMQ crawl/retry queues and the
# PostgreSQL-backed document ingest queue.
# Playwright is needed because many sites are SPAs (React/Next.js/Nuxt).

FROM mcr.microsoft.com/playwright:v1.56.1-noble AS deps
WORKDIR /app

# Install ALL deps (including devDeps for tsx TypeScript runner).
COPY package.json package-lock.json* ./
RUN npm install --ignore-scripts --legacy-peer-deps && test -x node_modules/.bin/tsx

# ── Runner ──────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/playwright:v1.56.1-noble AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Dependencies
COPY --from=deps /app/node_modules ./node_modules

# Workspace packages
COPY packages ./packages

# Source code
COPY src ./src
COPY workers ./workers
COPY tsconfig.json ./tsconfig.json
COPY tsconfig.worker.json ./tsconfig.worker.json

USER pwuser

# worker-entry starts the automatic document ingest poller, then loads the
# existing crawl/retry workers in the same long-lived process.
CMD ["node_modules/.bin/tsx", "--tsconfig", "tsconfig.worker.json", "workers/worker-entry.ts"]
