
# ═══════════════════════════════════════════════════════════════════════════════
# CLARA ENGINE — Required for all AI features
# ═══════════════════════════════════════════════════════════════════════════════
# All AI logic (chat, RAG, embeddings, voice, phone) runs in the private
# clara-engine microservice. Without these vars the app returns 503 on every
# AI endpoint.

CLARA_ENGINE_URL=https://engine.yourdomain.com
CLARA_ENGINE_WS_URL=wss://engine.yourdomain.com
CLARA_ENGINE_SECRET=change-me-use-openssl-rand-hex-32
