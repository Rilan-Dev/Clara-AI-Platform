{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "backups",
    "node_modules",
    ".next/**",
    ".next-app/**",
    "src/server/**",
    "src/vite/**",
    "vite.config.ts",
    "scripts/**",
    "**/*_DELETE_ME.ts",
    "**/*_DELETE_ME.tsx",
    "skills",
    "_archive",
    "download",
    "upload",
    "tool-results",
    "ai-platform-core/**",
    "clara-core/**",
    "docs/clara-core/**",
    "docs/doable-source/**"
  ]
}