{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --legacy-peer-deps --include=dev --prefer-offline --no-audit --no-fund",
  "buildCommand": "npm run db:migrate && npm run build",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/onboarding-reminders",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/platform/services-status",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/cron/ai-health",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/worker/reindex",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/whatsapp-daily-briefings",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/whatsapp-connection-health",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "src/app/api/queue/ingest/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "clara-ingest"
        }
      ],
      "maxDuration": 60
    },
    "src/app/api/queue/crawl/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "clara-crawl"
        }
      ],
      "maxDuration": 60
    },
    "api/voice-realtime.mjs": {
      "maxDuration": 300
    },
    "src/app/api/queue/scrape/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "clara-scrape"
        }
      ],
      "maxDuration": 60
    },
    "src/app/api/queue/retry/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "clara-retry"
        }
      ],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/embed/voice",
      "destination": "/api/voice-realtime/embed"
    },
    {
      "source": "/api/phone/twilio/stream",
      "destination": "/api/voice-realtime/twilio"
    },
    {
      "source": "/api/phone/vonage/stream",
      "destination": "/api/voice-realtime/vonage"
    },
    {
      "source": "/api/voice/sarvam/realtime",
      "destination": "/api/voice-realtime/sarvam"
    },
    {
      "source": "/api/voice/sarvam/tts-realtime",
      "destination": "/api/voice-realtime/sarvam-tts"
    },
    {
      "source": "/api/voice/elevenlabs/realtime",
      "destination": "/api/voice-realtime?channel=elevenlabs-stt"
    },
    {
      "source": "/api/voice/elevenlabs/tts-realtime",
      "destination": "/api/voice-realtime?channel=elevenlabs-tts"
    },
    {
      "source": "/api/voice/gemini/realtime",
      "destination": "/api/voice-realtime/gemini"
    },
    {
      "source": "/api/voice/elevenlabs/speech-engine",
      "destination": "/api/voice-realtime/speech-engine"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "fluid": true
}
