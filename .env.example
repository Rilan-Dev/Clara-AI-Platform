# ═══════════════════════════════════════════════════════════════════════════════
# Clara AI RAG — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# USAGE:  cp .env.example .env   →   fill in your secrets   →   never commit .env
# ═══════════════════════════════════════════════════════════════════════════════

# Optional local cross-encoder reranking (Hugging Face TEI POST /rerank).
# No third-party API is required. Deploy a reranker separately on the private network.
# Remains OFF until RAG_RERANK_URL points to a reachable TEI-compatible service.
# For the optional 'rerank' Compose profile, use:
# RAG_RERANK_URL="http://clara-reranker:80/rerank"
RAG_RERANK_ENABLED="true"
RAG_RERANK_URL=""
RAG_RERANK_TIMEOUT_MS="5000"
RAG_RERANK_MAX_CANDIDATES="12"
# RAG_RERANK_API_KEY=""  # If the private TEI service requires bearer auth.

# ─── AI Provider Selection ────────────────────────────────────────────────────
NEXT_PUBLIC_AI_PROVIDER="openai"
AI_PROVIDER="openai"
NEXT_PUBLIC_LANDING_EMBED_API_KEY="clr_your_kb_embed_key"

# ─── Gemini Configuration ─────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_CHAT_MODEL="" # Optional explicit override; otherwise use the live catalogue
GEMINI_EMBEDDING_MODEL="" # Optional explicit override; otherwise use the live catalogue
# Keep Gemini vectors dimension-compatible with OpenAI collections (1536) so
# switching AI_PROVIDER never breaks existing Qdrant collections.
GEMINI_EMBEDDING_DIMENSION="1536"
GEMINI_LIVE_MODEL="" # Optional explicit override; must exist in the live Gemini realtime catalogue
GEMINI_LIVE_VOICE="Aoede"

# ─── OpenAI Configuration ─────────────────────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"
# Optional: route OpenAI calls through a proxy / compatible gateway.
# OPENAI_BASE_URL="https://your-gateway.example.com/v1"
# Per-request timeout (ms) so unreachable networks fail fast with a clear
# error instead of hanging for the SDK default (10 minutes).
OPENAI_TIMEOUT_MS="60000"
OPENAI_CHAT_MODEL="" # Optional explicit override; otherwise use the live catalogue
OPENAI_EMBEDDING_MODEL="" # Optional explicit override; otherwise use the live catalogue
OPENAI_EMBEDDING_DIMENSION="1536"
OPENAI_CHAT_MAX_TOKENS="1500"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="alloy"
OPENAI_REALTIME_TEMPERATURE="0.8"
OPENAI_REALTIME_MAX_TOKENS="500"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-realtime-whisper"
OPENAI_REALTIME_INSTRUCTIONS="You are Clara, a helpful voice assistant."
OPENAI_REALTIME_VAD_THRESHOLD="0.5"
OPENAI_REALTIME_VAD_PREFIX_MS="300"
OPENAI_REALTIME_VAD_SILENCE_MS="700"

# ─── ElevenLabs Voice Provider (Mode A pipeline + Mode B Agents) ──────────────
# Mode A (default): STT + platform chat + streaming TTS through platform
# endpoints — used by the chat-window voice-chat feature and public embeds.
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_DEFAULT_STT_MODEL="scribe_v2"
ELEVENLABS_DEFAULT_VOICE_ID=""
# Optional: region-locked base URL (e.g. https://api.us.elevenlabs.io) for
# lower latency / data-residency routing of TTS + STT + Agents API calls.
# ELEVENLABS_BASE_URL="https://api.elevenlabs.io"
# Mode B (Conversational AI agents — vendor-brain realtime sessions, web +
# phone): sessions are minted through /api/voice/elevenlabs/agent-session
# (signed URLs), RAG grounding flows through the tool callback below, and
# phone calls ride the vendor register-call TwiML. All switches default OFF.
ELEVENLABS_CONVERSATIONAL_AI_ENABLED="false"

# Mode C (Clara-controlled realtime, plan Phase 6): Scribe realtime STT relay
# + streaming TTS WebSocket relay. Clara owns the turn (RAG+LLM) — the vendor
# only transports audio. DARK until explicitly enabled (plan Phase 13 rollout).
ELEVENLABS_REALTIME_STT_MODEL="scribe_v2_realtime"
ELEVENLABS_REALTIME_TTS_MODEL="eleven_flash_v2_5"
# Scribe v2 Realtime turn detection (VAD). Lower silence = faster turn handoff.
ELEVENLABS_REALTIME_VAD_SILENCE_SECS="0.8"
ELEVENLABS_REALTIME_VAD_THRESHOLD="0.4"
# Scribe realtime uses the dedicated scribe_v2_realtime WebSocket model.
# Shared static token sent as x-clara-tool-token by the vendor's RAG webhook
# tool (create one with: openssl rand -hex 32).
ELEVENLABS_TOOL_HMAC_SECRET=""
# Signing secret for ElevenLabs post-call webhooks — GENERATED by the vendor;
# auto-persisted by POST /api/admin/elevenlabs/webhooks (super-admin).
ELEVENLABS_WEBHOOK_SECRET=""

# ElevenLabs Speech Engine — true realtime voice for Clara-owned agents.
# ElevenLabs handles realtime microphone/STT/VAD/turn-taking/TTS while Clara
# remains the LLM/RAG/tenant runtime. The engine ID is safe to store here;
# ELEVENLABS_API_KEY must remain server-side.
ELEVENLABS_SPEECH_ENGINE_ENABLED="false"
ELEVENLABS_SPEECH_ENGINE_ID=""
ELEVENLABS_SPEECH_ENGINE_DEBUG="false"

# ─── Qdrant Vector Store ──────────────────────────────────────────────────────
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=""

# ─── Qwen local embeddings (llama.cpp) ───────────────────────────────────────
# Self-hosted embedding backbone: the `qwen-embeddings` docker-compose service
# (Qwen3-Embedding-0.6B Q8_0 GGUF, 1024-d, 100+ languages, 32k context) behind
# an OpenAI-compatible API. Download the model once (639 MB):
#   mkdir -p infra/qwen-embeddings && curl -L -o infra/qwen-embeddings/Qwen3-Embedding-0.6B-Q8_0.gguf \
#     https://huggingface.co/Qwen/Qwen3-Embedding-0.6B-GGUF/resolve/main/Qwen3-Embedding-0.6B-Q8_0.gguf
# Leave unset on Vercel (no local server) — the provider is skipped there.
QWEN_EMBEDDINGS_BASE_URL="http://qwen-embeddings:8080"
# Optional bearer key when the server is started with an API key.
QWEN_API_KEY=""
QWEN_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
QWEN_EMBEDDING_DIMENSION="1024"
# Query task instruction (Qwen3-Embedding instruct format).
# QWEN_EMBEDDINGS_QUERY_TASK="Given a question, retrieve passages from the knowledge base that answer the question"
# QWEN_EMBEDDINGS_TIMEOUT_MS="30000"

# ─── Multilingual knowledge index (optional) ─────────────────────────────────
# Also editable in Settings → AI → Multilingual knowledge index (saved values
# there win). VPS: point it at the local qwen-embeddings service below. Vercel:
# any OpenAI-compatible /v1/embeddings endpoint serving a compatible model.
MULTILINGUAL_EMBEDDINGS_ENABLED="false"
MULTILINGUAL_EMBEDDINGS_BASE_URL=""
MULTILINGUAL_EMBEDDINGS_API_KEY=""
MULTILINGUAL_EMBEDDINGS_MODEL="Qwen/Qwen3-Embedding-0.6B"
# Only for a model the platform does not know (known models set it themselves).
MULTILINGUAL_EMBEDDINGS_DIMENSION=""
# Evidence cut-off: E5 families sit between ~0.7 and 1.0; Qwen3/BGE behave
# like OpenAI/Gemini (full 0–1 range) — 0.35 / 0.45 respectively.
# MULTILINGUAL_EMBEDDINGS_SCORE_THRESHOLD="0.35"

# ─── Admin Authentication ─────────────────────────────────────────────────────
AUTH_SECRET="replace_with_secure_random_secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_admin_password"

# ─── CORS Policy ──────────────────────────────────────────────────────────────
# ALLOWED_ORIGIN="https://app.yourcompany.com"

# ─── Embedding Batch Tuning ───────────────────────────────────────────────────
EMBED_BATCH_SIZE="20"
EMBED_BATCH_DELAY="300"
EMBED_MAX_RETRIES="4"

# ─── Outbound Network / Egress (provider reachability) ────────────────────────
# Deployments on networks that cannot reach vendor endpoints (seen live:
# generativelanguage.googleapis.com:443 connect-timeout on restricted ISPs
# while api.openai.com works) need ONE of the three routes below. Diagnose
# from inside the container first:
#   docker compose exec clara-backend node scripts/probe-embedding-egress.mjs
# It stages DNS -> TCP -> TLS -> HTTP -> a real embedding round-trip and
# prints the exact remediation for the layer that fails.

# Route ALL provider traffic (Gemini/OpenAI/ElevenLabs/Sarvam) through an
# egress proxy reachable from this host. Loopback (Postgres/Redis/Qdrant/
# RabbitMQ) always stays direct via NO_PROXY.
# HTTPS_PROXY="http://host.docker.internal:7890"
# NO_PROXY="localhost,127.0.0.1,::1"
# Outbound TCP connect timeout (default 20s; undici's 10s is too short for
# slow international routes).
# EGRESS_CONNECT_TIMEOUT_MS="20000"

# Route ONLY Gemini through an HTTPS relay you control (a tiny Cloudflare
# Worker or nginx proxy that forwards to generativelanguage.googleapis.com).
# The platform, health probes and error messages all honour this.
# GEMINI_BASE_URL="https://your-gemini-relay.example.com"

# Fully offline embeddings (no vendor network at all): the qwen-embeddings
# compose service runs Qwen3-Embedding-0.6B locally; the governance provider
# "qwen" (migration 076) appears in Settings → AI Platform → Embeddings next
# to OpenAI and Gemini, and can back the multilingual index via
# MULTILINGUAL_EMBEDDINGS_BASE_URL="http://qwen-embeddings:8080".

# ─── Debug observability (docker logs / vercel logs ↔ devtools Network tab) ──
# NET_TRACE mirrors the browser Network tab on the SERVER side: method, path,
# status, duration, request/response previews and the full error cause chain
# are printed to stdout, which is `docker compose logs -f clara-backend`
# locally / VPS and Deployments → Functions logs on Vercel. Failures are
# ALWAYS captured (independent of this flag) and ALSO recorded as
# platform-health incidents (super-admin banner + email) — org users only
# ever see curated messages, never these details.
#   off      (default) quiet logs; failure capture still on
#   on       one summary row per traced request (chat, embed/search, embed/chat)
#   verbose  + redacted request/response body previews and per-vendor-call
#            upstream rows (Gemini/OpenAI chat + embeddings): URL, HTTP
#            status, duration, compact res summary — the server-side egress
#            the browser Network tab can never show. Vendor failures carry
#            their HTTP status (429/401/timeouts) and are ALWAYS captured
#            regardless of this flag.
# Every response echoes x-request-id = the id in the log row, so the devtools
# Network entry and the docker/vercel log line map 1:1. Payload previews are
# PII-redacted and credential-scrubbed before printing. Turn on only while
# debugging; Vercel picks up env changes on the next deployment.
# NET_TRACE="on"
# NET_TRACE_BODY_CHARS="1200"             # preview length (200–20000)
# NET_TRACE_SLOW_MS="1500"                # "slow" marker threshold

# ─── Environment Scoping (dev + prod on the SAME servers) ────────────────────
# Set CLARA_ENV=development in the DEV stack's .env only. One knob isolates
# every store — full guide: docs/deployment/environments.md
#   Postgres   -> schema clara_dev      (same DATABASE_URL, same server)
#   Qdrant     -> new collections dev_* (existing ones untouched)
#   BullMQ     -> key prefix dev_       (or prefer REDIS_URL db index)
#   RabbitMQ   -> vhost (RABBITMQ_VHOST below)
#
# Optional feature families — local to THIS application deployment only:
#   production (CLARA_ENV unset/production): widget + integrations OFF
#   development (CLARA_ENV=development):     widget + integrations ON
# Explicit true/false overrides are independent for each deployment.
# Never prefix with NEXT_PUBLIC_, store in a shared DB, or reuse the PROD .env
# for a development app: a dev change must not enable production endpoints.
# CLARA_FEATURE_EMBEDDABLE_WIDGET="false"
# CLARA_FEATURE_INTEGRATIONS="false"
# To exercise MCP tool execution in development, also enable the existing
# ENABLE_MCP="true" governance flag and configure valid MCP/plan grants.
# These feature switches do not override existing security permissions.
# Production default: everything unscoped — existing deployments are
# byte-identical after upgrading. Explicit overrides:
# CLARA_ENV="development"
# PG_SCHEMA="clara_dev"                # e.g. clara_prod to move prod off public
# QDRANT_COLLECTION_PREFIX="dev_"      # "" disables
# BULLMQ_PREFIX="dev_"                 # "" disables; prefer REDIS_URL /db index
# Redis isolation (preferred — no key changes): pick a logical db per env.
# REDIS_URL="redis://:password@redis:6379/1"
# REDIS_DB="1"                         # only for the REDIS_HOST/PORT form
# RabbitMQ vhost for the bridge (create once on a shared broker:
#   docker compose exec rabbitmq rabbitmqctl add_vhost clara_dev
#   docker compose exec rabbitmq rabbitmqctl set_permissions -p clara_dev clara ".*" ".*" ".*")
# RABBITMQ_VHOST="%2F"

# ─── Ingest Queue (PostgreSQL-backed) ─────────────────────────────────────
# A background poller inside the app server claims pending ingest_jobs every
# INGEST_POLLER_INTERVAL_MS — uploads no longer depend on an HTTP self-trigger
# (which fails inside Docker networks where the public origin is unreachable).
INGEST_POLLER_ENABLED="true"
INGEST_POLLER_INTERVAL_MS="3000"
INGEST_POLLER_MAX_JOBS="5"
# Jobs stuck 'running' longer than this (worker crashed / container restart)
# are automatically reset to pending and re-processed.
INGEST_STALE_JOB_MS="600000"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
# NEXT_DEPLOYMENT_ID="2026-09-13-release-01"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://clara:clarapassword@postgres:5432/clara_platform?sslmode=disable"
# Connections per server process. Vercel always uses 1. Self-hosted default
# is 10 (3 when DATABASE_URL is a Supabase pooler). One connection on a VPS
# serialises every request and makes the status page flap.
# PG_POOL_MAX="10"

# ─── Background Queue / Crawl Worker ──────────────────────────────────────────
# Crawl/retry job execution remains BullMQ + Redis.
REDIS_HOST="redis"
REDIS_PORT="6379"
# Set a password: docker-compose.yml enables Redis requirepass with it and
# the app/worker authenticate with the same value.
# REDIS_PASSWORD="replace_with_long_random_password"
WORKER_SECRET="replace_with_worker_secret"
CRAWL_WORKER_CONCURRENCY="2"
RETRY_WORKER_CONCURRENCY="3"

# ─── Local RabbitMQ SaaS Event Bus ─────────────────────────────────────────────
# RabbitMQ runs inside docker-compose.yml. The bridge connects to the service
# name "rabbitmq" over the internal Docker network, not localhost.
RABBITMQ_DEFAULT_USER="clara"
RABBITMQ_DEFAULT_PASS="clara-rabbitmq-local"
RABBITMQ_DEFAULT_VHOST="/"
RABBITMQ_URL="amqp://clara:clara-rabbitmq-local@rabbitmq:5672/%2F"

# The bridge calls these internal application endpoints to relay the
# PostgreSQL transactional outbox. Do not expose the bridge publicly.
CLARA_INTERNAL_API_URL="http://clara-backend:3000"
RABBITMQ_OUTBOX_POLL_MS="1000"
RABBITMQ_WEBHOOK_PREFETCH="10"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# ─── Phase 6: Upload Virus Scanning (optional hook) ───────────────────────────
# When set, uploaded documents are POSTed to {VIRUS_SCAN_URL}/scan?filename=…
# (raw bytes) before persistence. Expected JSON response: { clean: boolean,
# signature?: string }. Unset = hook disabled (pass-through). Fail-closed:
# a configured-but-unreachable scanner rejects uploads with 503.
VIRUS_SCAN_URL=""
VIRUS_SCAN_API_KEY=""
VIRUS_SCAN_TIMEOUT_MS="15000"

# ─── Sarvam AI (Indic-first brain + voice + language provider — V0 dark launch)
# Auth: every Sarvam call sends the key as the `api-subscription-key` header.
SARVAM_API_KEY=""
# Fixed base URL (SSRF guard). Override only for SageMaker self-hosting.
SARVAM_BASE_URL="https://api.sarvam.ai"
# Vendor timeout (chat 60s, STT 90s headroom).
SARVAM_TIMEOUT_MS="30000"
# Brain axis: chat only — Sarvam publishes no embeddings API; embeddings stay
# on the platform backbone via the fallback provider below (V1 resolve split).
SARVAM_CHAT_MODEL="sarvam-105b"
# Expose beta open-source chat models (gemma4, glm5.3, deepseekv4-flash).
SARVAM_BETA_MODELS_ENABLED="false"
# Voice axis: Bulbul TTS + Saaras STT pipeline (V2).
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_STT_MODEL="saaras:v3"
SARVAM_REALTIME_STT_MODEL="saaras:v3-realtime"
SARVAM_REALTIME_LLM_MODEL="sarvam-105b-conversations"
SARVAM_REALTIME_TTS_ENABLED="true"
SARVAM_DEFAULT_SPEAKER="shubh"
# Embedding backbone when an org's brain provider is sarvam (openai|gemini|qwen).
SARVAM_EMBEDDING_FALLBACK_PROVIDER="openai"
# Language services (translate / transliterate / identify — V4).
SARVAM_TRANSLATION_ENABLED="false"
SARVAM_TRANSLATE_MODEL="sarvam-translate:v1"
# INR→USD FX rate for cost estimation (catalogue prices convert at 0.012).
SARVAM_INR_TO_USD="0.012"

# ── Sarvam runtime additions (V1–V6) ────────────────────────────────────────
# Realtime voice agent: always streams — Saaras realtime STT WebSocket
# (scripts/sarvam-relay.mjs) + Bulbul streaming TTS WebSocket
# (scripts/sarvam-tts-relay.mjs). The one-shot REST STT/TTS serve the chat
# window's Voice Chat. Endpointing + pace tuning (blank = documented default):
SARVAM_REALTIME_VAD_THRESHOLD=""     # 0.05–0.95, default 0.3
SARVAM_REALTIME_SILENCE_MS=""        # 100–3000, default 500
SARVAM_REALTIME_MIN_SPEECH_MS=""     # 50–2000, default 250
SARVAM_TTS_PACE=""                   # 0.5–2.0, default 1.0
# Chat timeout override (default: max(SARVAM_TIMEOUT_MS, 60s)).
SARVAM_CHAT_TIMEOUT_MS=""
# Cost overrides for dashboards (blank = catalogue prices converted at
# SARVAM_INR_TO_USD).
SARVAM_TTS_USD_PER_1K_CHARS=""
SARVAM_STT_USD_PER_MIN=""
SARVAM_TRANSLATE_USD_PER_10K_CHARS=""

# ─── Support inbox & quota safety ─────────────────────────────────────────────
# Receives /contact demo requests and billing-activation reviews. Without it,
# the contact form reports "temporarily unavailable" instead of losing leads.
CLARA_SUPPORT_EMAIL=""
# What happens when plan limits can't be verified (e.g. a DB error):
#   open   — allow the request (default; usage may exceed plan caps)
#   closed — refuse the request
PLAN_GUARD_FAIL_MODE="open"

# ─── Background jobs (document ingest, crawl, scrape, retries) ────────────────
# vercel = Vercel Queues (only works inside Vercel Functions)
# local  = run in this Node process (Docker / VPS / `npm start`)
# Unset  = vercel on Vercel, local everywhere else.
# CLOUD_QUEUE_MODE=""

# ─── Cross-lingual retrieval & realtime grounding latency ─────────────────────
# A question asked in another language than the KB documents (e.g. Tamil
# question, English FAQ) is also searched with a KB-language translation.
# Orgs with Sarvam query translation enabled use Sarvam; others use one short
# completion on the tenant's embedding provider (OpenAI / Gemini).
# RAG_QUERY_TRANSLATION="on"                # "off" disables it
# RAG_QUERY_TRANSLATION_MODEL=""            # default: provider's chat model (gpt-4o-mini / gemini-2.0-flash)
# RAG_QUERY_TRANSLATION_TIMEOUT_MS="2500"   # after this the untranslated search is used
# GROUNDING_GRAPH_BUDGET_MS="1200"          # max wait for graph RAG on a grounding turn

# ─── Neo4j Graph RAG pilot (strictly opt-in) ────────────────────────────────
# Start only the isolated graph service with:
#   docker compose --profile graph up -d neo4j
# Provide a strong password before starting; never disable Neo4j auth.
# Backend/worker connect to the internal Compose service, not public Bolt.
NEO4J_PASSWORD=""
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USERNAME="neo4j"
NEO4J_IMAGE="neo4j:2026.10.1-community"
GRAPH_STORE_PROVIDER="memory"              # change to neo4j only after pilot accepted
ENABLE_GRAPH_INDEXING="false"              # opt-in document graph extraction
ENABLE_GRAPH_RAG="false"                   # independent query-time gate
# GRAPH_INDEXING_NOTE: The current pilot extractor indexes only explicit
# structured-reference hierarchies; human-reviewed business relationships,
# graph versioning, org UI selection and agentic RAG are not yet implemented.

# ─── Self-hosted (VPS / Docker) operations ────────────────────────────────────
# Required on every deployment. Vercel Cron sends it; on a VPS the app runs
# the same vercel.json crons in-process and sends it too (onboarding
# reminders, scheduled platform health check). Generate: openssl rand -hex 32
CRON_SECRET="replace_with_cron_secret"
# LOCAL_CRON_ENABLED="true"                 # "false" if an external cron calls the routes
# HEALTH_CHECK_TIMEOUT_MS="5000"            # System Status per-service timeout
# Infrastructure ports (Postgres, Redis, Qdrant, RabbitMQ) bind here. Keep
# 127.0.0.1 — the app reaches them over the Docker network.
# INFRA_BIND_ADDRESS="127.0.0.1"
# APP_BIND_ADDRESS="0.0.0.0"                # the app's :3000 for your reverse proxy
# QDRANT_IMAGE="qdrant/qdrant:latest"       # pin to the version your server runs



INTEGRATION_ENCRYPTION_KEY=<generated-64-character-hex-value> # Use Command: "openssl rand -hex 32"