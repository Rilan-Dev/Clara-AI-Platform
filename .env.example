# ═══════════════════════════════════════════════════════════════════════════════
# Clara AI RAG — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# USAGE:  cp .env.example .env   →   fill in your secrets   →   never commit .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI Provider Selection ────────────────────────────────────────────────────
NEXT_PUBLIC_AI_PROVIDER="openai"
AI_PROVIDER="openai"
NEXT_PUBLIC_LANDING_EMBED_API_KEY="clr_your_kb_embed_key"

# ─── Gemini Configuration ─────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Keep Gemini vectors dimension-compatible with OpenAI collections (1536) so
# switching AI_PROVIDER never breaks existing Qdrant collections.
GEMINI_EMBEDDING_DIMENSION="1536"
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_LIVE_VOICE="Aoede"

# ─── OpenAI Configuration ─────────────────────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"
# Optional: route OpenAI calls through a proxy / compatible gateway.
# OPENAI_BASE_URL="https://your-gateway.example.com/v1"
# Per-request timeout (ms) so unreachable networks fail fast with a clear
# error instead of hanging for the SDK default (10 minutes).
OPENAI_TIMEOUT_MS="60000"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION="1536"
OPENAI_CHAT_MAX_TOKENS="1500"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="alloy"
OPENAI_REALTIME_TEMPERATURE="0.8"
OPENAI_REALTIME_MAX_TOKENS="500"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-realtime-whisper"
OPENAI_REALTIME_INSTRUCTIONS="You are Clara, a helpful voice assistant."
OPENAI_REALTIME_VAD_THRESHOLD="0.5"
OPENAI_REALTIME_VAD_PREFIX_MS="300"
OPENAI_REALTIME_VAD_SILENCE_MS="700"

# ─── ElevenLabs Voice Provider (Mode A pipeline + Mode B Agents) ──────────────
# Mode A (default): STT + platform chat + streaming TTS through platform
# endpoints — used by the chat-window voice-chat feature and public embeds.
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_TTS_MODEL="eleven_flash_v2_5"
ELEVENLABS_DEFAULT_STT_MODEL="scribe_v2"
ELEVENLABS_DEFAULT_VOICE_ID=""
# Optional: region-locked base URL (e.g. https://api.us.elevenlabs.io) for
# lower latency / data-residency routing of TTS + STT + Agents API calls.
# ELEVENLABS_BASE_URL="https://api.elevenlabs.io"
# Mode B (Conversational AI agents — vendor-brain realtime sessions, web +
# phone): sessions are minted through /api/voice/elevenlabs/agent-session
# (signed URLs), RAG grounding flows through the tool callback below, and
# phone calls ride the vendor register-call TwiML. All switches default OFF.
ELEVENLABS_CONVERSATIONAL_AI_ENABLED="false"

# Mode C (Clara-controlled realtime, plan Phase 6): Scribe realtime STT relay
# + streaming TTS WebSocket relay. Clara owns the turn (RAG+LLM) — the vendor
# only transports audio. DARK until explicitly enabled (plan Phase 13 rollout).
ELEVENLABS_REALTIME_ENABLED="false"
ELEVENLABS_REALTIME_STT_MODEL="scribe_v2_realtime"
ELEVENLABS_REALTIME_TTS_MODEL="eleven_flash_v2_5"
# Scribe realtime uses the dedicated scribe_v2_realtime WebSocket model.
ELEVENLABS_REALTIME_STT_MODEL="scribe_v2_realtime"
# Shared static token sent as x-clara-tool-token by the vendor's RAG webhook
# tool (create one with: openssl rand -hex 32).
ELEVENLABS_TOOL_HMAC_SECRET=""
# Signing secret for ElevenLabs post-call webhooks — GENERATED by the vendor;
# auto-persisted by POST /api/admin/elevenlabs/webhooks (super-admin).
ELEVENLABS_WEBHOOK_SECRET=""

# ElevenLabs Speech Engine — true realtime voice for Clara-owned agents.
# ElevenLabs handles realtime microphone/STT/VAD/turn-taking/TTS while Clara
# remains the LLM/RAG/tenant runtime. The engine ID is safe to store here;
# ELEVENLABS_API_KEY must remain server-side.
ELEVENLABS_SPEECH_ENGINE_ENABLED="false"
ELEVENLABS_SPEECH_ENGINE_ID=""
ELEVENLABS_SPEECH_ENGINE_DEBUG="false"

# ─── Qdrant Vector Store ──────────────────────────────────────────────────────
QDRANT_URL="http://qdrant:6333"
QDRANT_API_KEY=""

# ─── Admin Authentication ─────────────────────────────────────────────────────
AUTH_SECRET="replace_with_secure_random_secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_admin_password"

# ─── CORS Policy ──────────────────────────────────────────────────────────────
# ALLOWED_ORIGIN="https://app.yourcompany.com"

# ─── Embedding Batch Tuning ───────────────────────────────────────────────────
EMBED_BATCH_SIZE="20"
EMBED_BATCH_DELAY="300"
EMBED_MAX_RETRIES="4"

# ─── Ingest Queue (PostgreSQL-backed) ─────────────────────────────────────
# A background poller inside the app server claims pending ingest_jobs every
# INGEST_POLLER_INTERVAL_MS — uploads no longer depend on an HTTP self-trigger
# (which fails inside Docker networks where the public origin is unreachable).
INGEST_POLLER_ENABLED="true"
INGEST_POLLER_INTERVAL_MS="3000"
INGEST_POLLER_MAX_JOBS="5"
# Jobs stuck 'running' longer than this (worker crashed / container restart)
# are automatically reset to pending and re-processed.
INGEST_STALE_JOB_MS="600000"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
# NEXT_DEPLOYMENT_ID="2026-09-13-release-01"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://clara:clarapassword@postgres:5432/clara_platform?sslmode=disable"

# ─── Background Queue / Crawl Worker ──────────────────────────────────────────
# Crawl/retry job execution remains BullMQ + Redis.
REDIS_HOST="redis"
REDIS_PORT="6379"
WORKER_SECRET="replace_with_worker_secret"
CRAWL_WORKER_CONCURRENCY="2"
RETRY_WORKER_CONCURRENCY="3"

# ─── Local RabbitMQ SaaS Event Bus ─────────────────────────────────────────────
# RabbitMQ runs inside docker-compose.yml. The bridge connects to the service
# name "rabbitmq" over the internal Docker network, not localhost.
RABBITMQ_DEFAULT_USER="clara"
RABBITMQ_DEFAULT_PASS="clara-rabbitmq-local"
RABBITMQ_DEFAULT_VHOST="/"
RABBITMQ_URL="amqp://clara:clara-rabbitmq-local@rabbitmq:5672/%2F"

# The bridge calls these internal application endpoints to relay the
# PostgreSQL transactional outbox. Do not expose the bridge publicly.
CLARA_INTERNAL_API_URL="http://clara-backend:3000"
RABBITMQ_OUTBOX_POLL_MS="1000"
RABBITMQ_WEBHOOK_PREFETCH="10"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# ─── Phase 6: Upload Virus Scanning (optional hook) ───────────────────────────
# When set, uploaded documents are POSTed to {VIRUS_SCAN_URL}/scan?filename=…
# (raw bytes) before persistence. Expected JSON response: { clean: boolean,
# signature?: string }. Unset = hook disabled (pass-through). Fail-closed:
# a configured-but-unreachable scanner rejects uploads with 503.
VIRUS_SCAN_URL=""
VIRUS_SCAN_API_KEY=""
VIRUS_SCAN_TIMEOUT_MS="15000"

# ─── Sarvam AI (Indic-first brain + voice + language provider — V0 dark launch)
# Auth: every Sarvam call sends the key as the `api-subscription-key` header.
SARVAM_API_KEY=""
# Fixed base URL (SSRF guard). Override only for SageMaker self-hosting.
SARVAM_BASE_URL="https://api.sarvam.ai"
# Vendor timeout (chat 60s, STT 90s headroom).
SARVAM_TIMEOUT_MS="30000"
# Brain axis: chat only — Sarvam publishes no embeddings API; embeddings stay
# on the platform backbone via the fallback provider below (V1 resolve split).
SARVAM_CHAT_MODEL="sarvam-105b"
# Expose beta open-source chat models (gemma4, glm5.3, deepseekv4-flash).
SARVAM_BETA_MODELS_ENABLED="false"
# Voice axis: Bulbul TTS + Saaras STT pipeline (V2).
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_STT_MODEL="saaras:v3"
SARVAM_REALTIME_STT_MODEL="saaras:v3-realtime"
SARVAM_REALTIME_LLM_MODEL="sarvam-105b-conversations"
SARVAM_REALTIME_TTS_ENABLED="true"
SARVAM_DEFAULT_SPEAKER="shubh"
# Embedding backbone when an org's brain provider is sarvam (openai|gemini).
SARVAM_EMBEDDING_FALLBACK_PROVIDER="openai"
# Language services (translate / transliterate / identify — V4).
SARVAM_TRANSLATION_ENABLED="false"
SARVAM_TRANSLATE_MODEL="sarvam-translate:v1"
# INR→USD FX rate for cost estimation (catalogue prices convert at 0.012).
SARVAM_INR_TO_USD="0.012"

# ── Sarvam runtime additions (V1–V6) ────────────────────────────────────────
# Realtime STT relay (V5): stream partial transcripts for live captions and
# early barge-in via scripts/sarvam-relay.mjs. Requires the custom server
# (npm run start / docker) and a restart to take effect.
SARVAM_REALTIME_STT_ENABLED="false"
# Chat timeout override (default: max(SARVAM_TIMEOUT_MS, 60s)).
SARVAM_CHAT_TIMEOUT_MS=""
# Cost overrides for dashboards (blank = catalogue prices converted at
# SARVAM_INR_TO_USD).
SARVAM_TTS_USD_PER_1K_CHARS=""
SARVAM_STT_USD_PER_MIN=""
SARVAM_TRANSLATE_USD_PER_10K_CHARS=""
