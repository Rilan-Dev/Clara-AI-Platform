# Clara AI Platform — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://clara:clarapassword@localhost:5432/clara_platform

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=clara
POSTGRES_PASSWORD=clarapassword
POSTGRES_DB=clara_platform
POSTGRES_PORT=5432

# ── Vector Database ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # leave blank for local Qdrant

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 64
AUTH_SECRET=change-me-with-a-long-random-string

# ── Public URL (used in emails, embeds, CORS) ─────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (optional — leave blank to disable billing) ───────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Tenant app org IDs (from seed script) ────────────────────────────────────
OMEN_ORG_ID=10000000-0000-0000-0000-000000000001
TECHVISION_ORG_ID=10000000-0000-0000-0000-000000000002

# ── Tenant apps ───────────────────────────────────────────────────────────────
# Used by clara-omen-insurance and clara-techvision to call the backend
CLARA_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_CLARA_API_URL=http://localhost:3000

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
