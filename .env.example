# ═══════════════════════════════════════════════════════════════════════════════
# Clara AI RAG — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# USAGE:  cp .env.example .env   →   fill in your secrets   →   never commit .env
# ═══════════════════════════════════════════════════════════════════════════════

# ─── AI Provider Selection ────────────────────────────────────────────────────
NEXT_PUBLIC_AI_PROVIDER="openai"
AI_PROVIDER="openai"
NEXT_PUBLIC_LANDING_EMBED_API_KEY="clr_your_kb_embed_key"

# ─── Gemini Configuration ─────────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_LIVE_VOICE="Aoede"

# ─── OpenAI Configuration ─────────────────────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION="1536"
OPENAI_CHAT_MAX_TOKENS="1500"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="alloy"
OPENAI_REALTIME_TEMPERATURE="0.8"
OPENAI_REALTIME_MAX_TOKENS="500"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-realtime-whisper"
OPENAI_REALTIME_INSTRUCTIONS="You are Clara, a helpful voice assistant."
OPENAI_REALTIME_VAD_THRESHOLD="0.5"
OPENAI_REALTIME_VAD_PREFIX_MS="300"
OPENAI_REALTIME_VAD_SILENCE_MS="700"

# ─── Qdrant Vector Store ──────────────────────────────────────────────────────
QDRANT_URL="https://your-qdrant-cluster:6333"
QDRANT_API_KEY="your_qdrant_api_key"

# ─── Admin Authentication ─────────────────────────────────────────────────────
AUTH_SECRET="replace_with_secure_random_secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace_with_admin_password"

# ─── CORS Policy ──────────────────────────────────────────────────────────────
# ALLOWED_ORIGIN="https://app.yourcompany.com"

# ─── Embedding Batch Tuning ───────────────────────────────────────────────────
EMBED_BATCH_SIZE="20"
EMBED_BATCH_DELAY="300"
EMBED_MAX_RETRIES="4"

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
# NEXT_DEPLOYMENT_ID="2026-09-13-release-01"

# ─── Background Queue / Crawl Worker ──────────────────────────────────────────
# Crawl/retry job execution remains BullMQ + Redis.
REDIS_HOST="redis"
REDIS_PORT="6379"
WORKER_SECRET="replace_with_worker_secret"
CRAWL_WORKER_CONCURRENCY="2"

# ─── RabbitMQ SaaS Event Bus ──────────────────────────────────────────────────
# Production: use the CloudAMQP cluster AMQPS URL. Never commit the real value.
# Use the CloudAMQP cluster hostname and AMQPS port 5671.
# Example: amqps://username:password@cluster.rmq2.cloudamqp.com/vhost
# The password must be URL-encoded when it contains reserved URI characters.
RABBITMQ_URL="amqps://rabbit_user:rabbit_password@cluster.rmq2.cloudamqp.com/vhost"

# The bridge service calls these internal application endpoints to relay the
# PostgreSQL transactional outbox. Do not expose the bridge publicly.
# Docker Compose overrides this to http://clara-backend:3000 automatically.
CLARA_INTERNAL_API_URL="http://clara-backend:3000"
RABBITMQ_OUTBOX_POLL_MS="1000"
RABBITMQ_WEBHOOK_PREFETCH="10"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
