  "private": true,
  "scripts": {
    "dev": "node api.js && next dev -p 3000",
    "dev:relay": "node scripts/dev-relay.mjs",
    "postinstall": "node scripts/sync-monaco-assets.mjs",
    "build": "node api.js && next build --webpack",
    "start": "node api.js && node scripts/start.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:voice-benchmark": "node --check scripts/voice-benchmark/conversation.mjs && node --check scripts/voice-benchmark/validate-report.mjs && node --check scripts/voice-benchmark/validate-report.test.mjs && node scripts/voice-benchmark/validate-report.test.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts --prod",
    "seed:prod": "tsx scripts/seed.ts --prod",
    "seed:dev": "tsx scripts/seed-demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:reset": "tsx scripts/seed-demo.ts --reset",
    "seed:clean": "tsx scripts/db-clean-demo.ts",
    "seed:docs": "node scripts/generate-seed-docs.mjs",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset:dev": "tsx scripts/db-reset.ts --dev",
    "ingest": "tsx scripts/ingest.ts",
    "ingest-web": "tsx scripts/ingest-web.ts",
    "scrape:benchmark": "tsx scripts/scrape-benchmark.ts",
    "scan-blocked-domains": "tsx scripts/scan-blocked-domains.ts",
    "validate:model-config": "node scripts/validate-model-config.mjs",
    "validate:model-config:db": "node scripts/validate-model-config.mjs --db",
    "validate:stylesheet": "node scripts/validate-stylesheet.mjs",
    "vercel-build": "npm run db:migrate && next build --webpack"
  },
