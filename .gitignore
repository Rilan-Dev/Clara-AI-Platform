# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# (unanchored: also covers nested installs like services/rabbitmq-bridge/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env
# .env.local
# .env.production
# .env.development
# !.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Deployment & Secrets ──────────────────────────────────
secrets/
deploy/nginx/certs/*.pem
deploy/nginx/certs/*.key
deploy/nginx/certs/*.crt

# ─── Scratch / temp files ──────────────────────────────────
old_hook.txt
VoiceChatModal_before_patch.txt
*.tar.gz

# ─── AI configuration backup artifacts (scripts/backup-ai-configuration.mjs) ──
# Logical exports contain organisation/agent configuration; physical dumps
# contain secrets. Never commit — copy off-host instead.
backups/ai-configuration-*.json
backups/clara-full-*.sql.gz

# ─── IDE & tools ───────────────────────────────────────────
.antigravityignore
.trunk

# auto-generated monaco assets
/public/monaco
infra

graphify-out
.vscode
mcp-servers