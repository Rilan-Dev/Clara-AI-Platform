# =========================================================
# Clara Platform - Environment Variables Example
# =========================================================


# =========================================================
# 1. Runtime / Server
# =========================================================

NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
KEEP_ALIVE_TIMEOUT=65000

NEXT_DEPLOYMENT_ID=local-dev


# =========================================================
# 2. Public App URLs
# Variables prefixed with NEXT_PUBLIC_ are exposed to frontend
# =========================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Used by frontend voice client
NEXT_PUBLIC_AI_PROVIDER=openai


# =========================================================
# 3. Backend / API Client
# =========================================================

CLARA_BACKEND_URL=http://localhost:3010
CLARA_ADMIN_TOKEN=dev-admin-token-change-me


# =========================================================
# 4. Auth / Security
# =========================================================

AUTH_SECRET=replace-with-long-random-auth-secret
NEXTAUTH_SECRET=replace-with-long-random-nextauth-secret
PLATFORM_CONFIRM_SECRET=replace-with-platform-confirm-secret
LOCAL_INIT_SECRET=replace-with-local-init-secret

# Local development only
SKIP_AUTH=false

# CORS
ALLOWED_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# =========================================================
# 5. PostgreSQL Database
# =========================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clara

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clara
POSTGRES_SSL=false

PG_POOL_MAX=10

AUTO_SEED_DEMO=false


# =========================================================
# 6. Redis / Queue
# =========================================================

REDIS_HOST=localhost
REDIS_PORT=6379


# =========================================================
# 7. Workers
# =========================================================

WORKER_SECRET=replace-with-worker-secret

CRAWL_WORKER_CONCURRENCY=2
RETRY_WORKER_CONCURRENCY=3


# =========================================================
# 8. Qdrant / Vector Store
# =========================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

QDRANT_CATALOG_COLLECTION=document_catalog

EMBED_BATCH_SIZE=20
EMBED_BATCH_DELAY=300
EMBED_MAX_RETRIES=4
UPSERT_BATCH_SIZE=200


# =========================================================
# 9. RAG / Graph RAG / Agentic Features
# =========================================================

# Options likely used in code: "classic" | "hybrid" | "agentic"
RAG_MODE=classic

ENABLE_GRAPH_RAG=false
ENABLE_AGENT_LOOP=false
ENABLE_SELF_EVAL=false
ENABLE_MCP=false

# Options likely: memory, external provider name if implemented
GRAPH_STORE_PROVIDER=memory


# =========================================================
# 10. AI Provider Selection
# =========================================================

# Options: openai, gemini
AI_PROVIDER=openai


# =========================================================
# 11. OpenAI
# =========================================================

OPENAI_API_KEY=sk-your-openai-api-key

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

OPENAI_CHAT_MAX_TOKENS=1500

OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_TEMPERATURE=0.8
OPENAI_REALTIME_MAX_TOKENS=500

OPENAI_REALTIME_INSTRUCTIONS=You are Clara, a helpful AI assistant.

OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_VAD_PREFIX_MS=300
OPENAI_REALTIME_VAD_SILENCE_MS=700


# =========================================================
# 12. Gemini
# =========================================================

GEMINI_API_KEY=your-gemini-api-key

GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede


# =========================================================
# 13. Voice Relay / Streaming Scripts
# =========================================================

VOICE_RELAY_PORT=3001


# =========================================================
# 14. Phone Providers - Twilio
# =========================================================

TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_WEBHOOK=false


# =========================================================
# 15. Phone Providers - Vonage
# =========================================================

VONAGE_API_SECRET=your-vonage-api-secret


# =========================================================
# 16. Stripe Payments
# =========================================================

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

STRIPE_PRICE_STARTER=price_starter_example
STRIPE_PRICE_PRO=price_pro_example


# =========================================================
# 17. Razorpay Payments
# =========================================================

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Public key exposed to frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id


# =========================================================
# 18. Email / Notifications
# =========================================================

RESEND_API_KEY=re_your_resend_api_key
SENDGRID_API_KEY=SG.your_sendgrid_api_key

SMTP_HOST=smtp.example.com

EMAIL_FROM_DOMAIN=clara.ai


# =========================================================
# 19. Scripts / Maintenance
# =========================================================

SCAN_URLS=https://example.com,https://another-example.com


# =========================================================
# 20. SDK / Docs Example Variables
# These appear inside documentation code snippets
# =========================================================

CLARA_API_KEY=clara_api_key_example
NEXT_PUBLIC_CLARA_KEY=public_clara_key_example


# =========================================================
# 21. Internal / Usually Do Not Manually Set
# =========================================================

# Set automatically by npm in many contexts
# npm_package_version=0.1.0

# Used internally by Next.js standalone server output
# __NEXT_PRIVATE_STANDALONE_CONFIG={}