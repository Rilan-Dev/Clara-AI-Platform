{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "next/server": ["./src/server/next-shim.ts"],
      "next/link": ["./src/vite/shims/next-link.tsx"],
      "next/navigation": ["./src/vite/shims/next-navigation.ts"],
      "next/dynamic": ["./src/vite/shims/next-dynamic.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "src/app/api/**",
    "src/middleware.ts",
    "scripts/**",
    "src/modules/**/api/**",
    "src/modules/auth/core/**",
    "src/modules/embed/core/**",
    "src/lib/plan-guard.ts"
  ]
}
