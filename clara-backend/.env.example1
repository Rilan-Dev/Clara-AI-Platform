# ═══════════════════════════════════════════════════════════════════════════════
# Clara AI RAG — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY NOTICE: Never commit this file to version control.
# Add .env to your .gitignore and use a secret manager in production.
# ───────────────────────────────────────────────────────────────────────────────


# ─── AI Provider Selection ─────────────────────────────────────────────────────
# Switch between "openai" and "gemini". Default is "openai".
NEXT_PUBLIC_AI_PROVIDER="openai"


# ─── Gemini Configuration ─────────────────────────────────────────────────────
# Required when AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"


# ─── OpenAI Configuration ──────────────────────────────────────────────────────
# ⚠️  ACTION REQUIRED: The previous key in this file was exposed.
#     Go to https://platform.openai.com/api-keys and:
#       1. Delete / revoke the old key immediately
#       2. Create a new key
#       3. Paste the new key below
OPENAI_API_KEY="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"

# Optional: override which models and limits Clara uses
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# OPENAI_CHAT_MAX_TOKENS="1500"           # Increased from 500 - covers detailed policy answers
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# OPENAI_EMBEDDING_DIMENSION="1536"
# OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"
# OPENAI_REALTIME_VOICE="alloy"                     # Server-side only - do NOT use NEXT_PUBLIC_ prefix
# OPENAI_REALTIME_TEMPERATURE="0.8"                 # 0.8 gives natural conversational delivery
# OPENAI_REALTIME_MAX_TOKENS="500"                  # Per-turn output cap (~60-80 spoken words)
# OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-4o-transcribe"  # More accurate than whisper-1
# OPENAI_REALTIME_INSTRUCTIONS="You are Clara, a voice-first RAG assistant. Answer ONLY using the context provided by the system or rag_search outputs. If you have insufficient information, say so briefly. Be concise, warm, and professionally supportive."
#
# VAD (Voice Activity Detection) tuning
# OPENAI_REALTIME_VAD_THRESHOLD="0.5"               # Energy threshold 0.0-1.0
# OPENAI_REALTIME_VAD_PREFIX_MS="300"               # ms of audio before speech to include
# OPENAI_REALTIME_VAD_SILENCE_MS="700"              # ms of silence before turn ends
# OPENAI_REALTIME_MAX_TOKENS="1024"        # Max output tokens per realtime response turn
# OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"  # Or "whisper-1" for cost savings

# VAD (Voice Activity Detection) tuning - controls when Clara stops listening
# OPENAI_VAD_THRESHOLD="0.5"    # 0.0-1.0 sensitivity; lower = more sensitive
# OPENAI_VAD_PREFIX_MS="300"    # Audio before speech start to include (ms)
# OPENAI_VAD_SILENCE_MS="800"   # Silence before turn ends (default 500ms too aggressive)

# Embedding batch processor tuning (optional)
# EMBED_BATCH_SIZE="20"     # Chunks per parallel batch (default: 20)
# EMBED_BATCH_DELAY="300"   # ms pause between batches (default: 300ms)
# EMBED_MAX_RETRIES="4"     # Retry attempts on 429 rate-limit errors (default: 4)


# ─── Qdrant Vector Store ───────────────────────────────────────────────────────
# ⚠️  ACTION REQUIRED:
#     1. Replace the API key below with a strong random value (32+ chars).
#        Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     2. Set the SAME key on your Qdrant server:
#        - In qdrant config.yaml:  api_key: <your-new-key>
#        - Or via env:  QDRANT__SERVICE__API_KEY=<your-new-key>
#     3. Firewall port 6333 on your server to only allow connections from
#        the app server IP — do NOT leave it publicly accessible.
QDRANT_URL="https://0551fc7b-34f4-4ee9-9976-ee713e9dda88.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.QWRR60TNHqUU8C7U3k9ONP6VFeAW3xA8VO2cD95BVuM"

# Optional: custom catalog collection name
# QDRANT_CATALOG_COLLECTION="document_catalog"


# ─── Admin Authentication (Phase 1 Security Fix) ──────────────────────────────
# Required by src/lib/auth.ts and src/app/api/auth/login/route.ts
#
# AUTH_SECRET: Used to sign session tokens with HMAC-SHA-256.
#   Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Must be at least 32 characters. Keep this secret.
AUTH_SECRET="42e0d776391316c39e7bd96701f54b6a6b826a0360cec18b9c66ed8cf68f8c6d"

# Admin login credentials for the /login page and /ingest workspace.
# These are checked by POST /api/auth/login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Redhat@123"


# ─── CORS Policy ─────────────────────────────────────────────────────────────
# Set this ONLY if your frontend is served from a different domain than the API.
# Leave unset (default) to enforce same-origin policy (most secure).
# Example: ALLOWED_ORIGIN="https://app.yourcompany.com"
# ALLOWED_ORIGIN=


# ─── Next.js Runtime ──────────────────────────────────────────────────────────
# NODE_ENV="production"
