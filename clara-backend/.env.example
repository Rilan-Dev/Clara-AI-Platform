# ═══════════════════════════════════════════════════════════════════════════════
# Clara AI RAG — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
# USAGE:  cp .env.example .env   →   fill in your secrets   →   never commit .env
# ═══════════════════════════════════════════════════════════════════════════════


# ─── AI Provider Selection ────────────────────────────────────────────────────
# Choose: "openai" or "gemini"
#
# NEXT_PUBLIC_AI_PROVIDER is the only provider-related var that belongs in the
# browser bundle — it is just a provider name ("openai"/"gemini"), not a secret.
# Everything else is server-side only (no NEXT_PUBLIC_ prefix on API keys).
NEXT_PUBLIC_AI_PROVIDER="openai"

# Server-side provider routing (used by ProviderFactory in server code).
# Keep in sync with NEXT_PUBLIC_AI_PROVIDER.
AI_PROVIDER="openai"


# ─── Gemini Configuration ─────────────────────────────────────────────────────
# Required when AI_PROVIDER="gemini"
#
# GEMINI_API_KEY is SERVER-SIDE ONLY.
# The browser never sees this value — useGeminiLive fetches the WebSocket URL
# from POST /api/gemini/session, which embeds the key server-side.
# DO NOT add NEXT_PUBLIC_GEMINI_API_KEY — that would expose the key to the
# browser JS bundle and should be considered a security incident.
GEMINI_API_KEY="your_gemini_api_key"

# Chat / embedding models (server-side)
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Gemini Live (voice) model and voice name
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_LIVE_VOICE="Aoede"


# ─── OpenAI Configuration ─────────────────────────────────────────────────────
# Required when AI_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSION="1536"
OPENAI_CHAT_MAX_TOKENS="1500"

# OpenAI Realtime Voice Configuration (all server-side only)
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"
OPENAI_REALTIME_VOICE="alloy"
OPENAI_REALTIME_TEMPERATURE="0.8"
OPENAI_REALTIME_MAX_TOKENS="500"
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_REALTIME_INSTRUCTIONS="You are Clara, a helpful voice assistant."

# VAD (Voice Activity Detection) tuning
OPENAI_REALTIME_VAD_THRESHOLD="0.5"
OPENAI_REALTIME_VAD_PREFIX_MS="300"
OPENAI_REALTIME_VAD_SILENCE_MS="700"


# ─── Qdrant Vector Store ──────────────────────────────────────────────────────
# For Docker Compose: use http://qdrant:6333
# For managed Qdrant Cloud: use your cluster URL
QDRANT_URL="https://your-qdrant-cluster:6333"
QDRANT_API_KEY="your_qdrant_api_key"

# QDRANT_CATALOG_COLLECTION="document_catalog"


# ─── Admin Authentication ─────────────────────────────────────────────────────
# Generate AUTH_SECRET:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace_with_secure_random_secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Redhat@123"


# ─── CORS Policy ──────────────────────────────────────────────────────────────
# Set only if frontend/API are on different domains
# ALLOWED_ORIGIN="https://app.yourcompany.com"


# ─── Embedding Batch Tuning ───────────────────────────────────────────────────
EMBED_BATCH_SIZE="20"
EMBED_BATCH_DELAY="300"
EMBED_MAX_RETRIES="4"


# ─── App URL (used for Stripe redirect URLs) ──────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# For self-hosted Next.js deployments behind reverse proxies / rolling updates:
# - Keep NEXT_SERVER_ACTIONS_ENCRYPTION_KEY stable across all running instances.
# - Change NEXT_DEPLOYMENT_ID on every release to help clients detect version skew.
# Generate key with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
# NEXT_DEPLOYMENT_ID="2026-03-13-release-01"


# ─── Background Queue / Crawl Worker ──────────────────────────────────────────
# Scrape discovery runs through BullMQ + Redis so long website crawls do not
# block the HTTP request behind nginx/openresty.
REDIS_HOST="redis"
REDIS_PORT="6379"

# Shared secret used by internal worker routes such as /api/worker/ingest.
# Generate with: openssl rand -hex 24
WORKER_SECRET="replace_with_worker_secret"

# Number of crawl jobs processed in parallel by the dedicated worker container.
CRAWL_WORKER_CONCURRENCY="2"


# ─── Stripe (Phase 3 — USD payments) ─────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# Webhook secret — from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# or from Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pre-created recurring monthly Price IDs (optional — fallback uses price_data)
# Create via: stripe prices create --unit-amount 4900 --currency usd --recurring interval=month --product-data name="Clara Starter"
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."


# ─── Razorpay (Phase 4 — INR payments) ───────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."

# Webhook secret — from Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET="..."

# Browser-safe copy of the key ID (no secret, safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
